{
  "info": {
    "_postman_id": "fit4110-lab03-iot-ingestion",
    "name": "FIT4110 Lab03 - IoT Ingestion (team-iot)",
    "description": "Contract tests for Smart Campus IoT Ingestion API.\nFolders: Functional, Auth, Negative, Boundary, Consumer-side smoke, Local-only.\nUses environment variables: baseUrl, authToken, aiVisionMockUrl, env.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01_Functional",
      "item": [
        {
          "name": "Health check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Health response has status ok', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.status).to.eql('ok');",
                  "  pm.expect(json).to.have.property('service');",
                  "  pm.expect(json).to.have.property('version');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Create sensor reading (happy path)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"ESP32-LAB-A01\",\n  \"metric\": \"temperature\",\n  \"value\": 31.5,\n  \"unit\": \"celsius\",\n  \"timestamp\": \"2026-05-13T08:30:00+07:00\"\n}"
            },
            "url": "{{baseUrl}}/readings"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response has reading_id and accepted', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('reading_id');",
                  "  pm.expect(json).to.have.property('device_id', 'ESP32-LAB-A01');",
                  "  pm.expect(json).to.have.property('metric', 'temperature');",
                  "  pm.expect(json.accepted).to.eql(true);",
                  "  pm.expect(json).to.have.property('created_at');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get latest readings",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/readings/latest"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Latest readings returns items array', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('items');",
                  "  pm.expect(json.items).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get latest readings with filters",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/readings/latest?device_id=ESP32-LAB-A01&limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["readings", "latest"],
              "query": [
                { "key": "device_id", "value": "ESP32-LAB-A01" },
                { "key": "limit", "value": "5" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Filtered latest returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Items array respects limit query', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.items).to.be.an('array');",
                  "  pm.expect(json.items.length).to.be.at.most(5);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02_Auth",
      "item": [
        {
          "name": "Create reading with valid token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"ESP32-LAB-A01\",\n  \"metric\": \"humidity\",\n  \"value\": 55,\n  \"unit\": \"percent\",\n  \"timestamp\": \"2026-05-13T09:00:00+07:00\"\n}"
            },
            "url": "{{baseUrl}}/readings"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Authorized request succeeds with 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Bearer token accepted for protected endpoint', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.accepted).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Create reading without token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"ESP32-LAB-A01\",\n  \"metric\": \"temperature\",\n  \"value\": 31.5,\n  \"unit\": \"celsius\",\n  \"timestamp\": \"2026-05-13T08:30:00+07:00\"\n}"
            },
            "url": "{{baseUrl}}/readings"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Missing token returns 401 or 403', function () {",
                  "  pm.expect([401, 403]).to.include(pm.response.code);",
                  "});",
                  "pm.test('Unauthorized follows ProblemDetails', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('status');",
                  "  pm.expect(json.status).to.be.within(400, 599);",
                  "  pm.expect(json).to.have.property('title');",
                  "  pm.expect(json).to.have.property('detail');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Create reading with invalid token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer invalid-wrong-token" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"ESP32-LAB-A01\",\n  \"metric\": \"temperature\",\n  \"value\": 31.5,\n  \"unit\": \"celsius\",\n  \"timestamp\": \"2026-05-13T08:30:00+07:00\"\n}"
            },
            "url": "{{baseUrl}}/readings"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const env = pm.environment.get('env');",
                  "pm.test('Invalid token rejected (strict on local)', function () {",
                  "  if (env === 'local') {",
                  "    pm.expect([401, 403]).to.include(pm.response.code);",
                  "  } else {",
                  "    pm.expect([401, 403, 201]).to.include(pm.response.code);",
                  "    if (pm.response.code === 201) {",
                  "      console.warn('Prism mock may not validate token value — verify on local service');",
                  "    }",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03_Negative",
      "item": [
        {
          "name": "Missing required device_id",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"metric\": \"temperature\",\n  \"value\": 31.5,\n  \"timestamp\": \"2026-05-13T08:30:00+07:00\"\n}"
            },
            "url": "{{baseUrl}}/readings"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Invalid payload returns client error', function () {",
                  "  pm.expect([400, 422]).to.include(pm.response.code);",
                  "});",
                  "pm.test('Error response follows ProblemDetails', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('status');",
                  "  pm.expect(json.status).to.be.within(400, 599);",
                  "  pm.expect(json).to.have.property('detail');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Invalid metric enum",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"ESP32-LAB-A01\",\n  \"metric\": \"pressure\",\n  \"value\": 31.5,\n  \"timestamp\": \"2026-05-13T08:30:00+07:00\"\n}"
            },
            "url": "{{baseUrl}}/readings"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Unknown metric returns 400 or 422', function () {",
                  "  pm.expect([400, 422]).to.include(pm.response.code);",
                  "});",
                  "pm.test('Validation error has ProblemDetails shape', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('title');",
                  "  pm.expect(json.status).to.be.at.least(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Invalid limit query parameter",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/readings/latest?limit=200",
              "host": ["{{baseUrl}}"],
              "path": ["readings", "latest"],
              "query": [
                { "key": "limit", "value": "200" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Limit above maximum returns 400', function () {",
                  "  pm.expect([400, 422]).to.include(pm.response.code);",
                  "});",
                  "pm.test('Error mentions validation', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('detail');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04_Boundary_Reliability",
      "item": [
        {
          "name": "High temperature at upper boundary (80)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"ESP32-LAB-A01\",\n  \"metric\": \"temperature\",\n  \"value\": 80,\n  \"unit\": \"celsius\",\n  \"timestamp\": \"2026-05-13T08:30:00+07:00\"\n}"
            },
            "url": "{{baseUrl}}/readings"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('High temperature accepted or rejected by server', function () {",
                  "  pm.expect([201, 400, 422]).to.include(pm.response.code);",
                  "  if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.accepted).to.eql(true);",
                  "    if (pm.response.headers.has('X-Warning')) {",
                  "      pm.expect(pm.response.headers.get('X-Warning')).to.be.a('string');",
                  "    }",
                  "  }",
                  "  if ([400, 422].includes(pm.response.code)) {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('detail');",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Low temperature at lower boundary (-40)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"ESP32-LAB-A01\",\n  \"metric\": \"temperature\",\n  \"value\": -40,\n  \"unit\": \"celsius\",\n  \"timestamp\": \"2026-05-13T08:30:00+07:00\"\n}"
            },
            "url": "{{baseUrl}}/readings"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Lower boundary value handled by server response', function () {",
                  "  pm.expect([201, 400, 422]).to.include(pm.response.code);",
                  "  if (pm.response.code === 201) {",
                  "    pm.expect(pm.response.json().accepted).to.eql(true);",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Value above schema maximum rejected",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"ESP32-LAB-A01\",\n  \"metric\": \"temperature\",\n  \"value\": 81,\n  \"unit\": \"celsius\",\n  \"timestamp\": \"2026-05-13T08:30:00+07:00\"\n}"
            },
            "url": "{{baseUrl}}/readings"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Out-of-range temperature returns client error', function () {",
                  "  pm.expect([400, 422]).to.include(pm.response.code);",
                  "});",
                  "pm.test('Server returns ProblemDetails for out-of-range', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('status');",
                  "  pm.expect(json).to.have.property('detail');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Rate limit response (mock Prefer)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Prefer", "value": "code=429" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"ESP32-LAB-A01\",\n  \"metric\": \"temperature\",\n  \"value\": 31.5,\n  \"unit\": \"celsius\",\n  \"timestamp\": \"2026-05-13T08:30:00+07:00\"\n}"
            },
            "url": "{{baseUrl}}/readings"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.environment.get('env') === 'mock') {",
                  "  pm.test('Rate limit contract returns 429 on mock', function () {",
                  "    pm.response.to.have.status(429);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(429);",
                  "    pm.expect(json).to.have.property('detail');",
                  "  });",
                  "} else {",
                  "  pm.test('Rate limit Prefer test skipped on local', function () {",
                  "    pm.expect(pm.environment.get('env')).to.eql('local');",
                  "  });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05_Consumer_side_Smoke",
      "item": [
        {
          "name": "AI Vision health (dependency)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{aiVisionMockUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('AI Vision mock is reachable', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Dependency service reports ok', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.status).to.eql('ok');",
                  "  pm.expect(json.service).to.eql('ai-vision');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "AI Vision detect smoke",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"camera_id\": \"CAM01\",\n  \"image_url\": \"https://example.com/frame.jpg\"\n}"
            },
            "url": "{{aiVisionMockUrl}}/detect"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Consumer can call AI Vision detect', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Detection response has required fields', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('detection_id');",
                  "  pm.expect(json).to.have.property('label');",
                  "  pm.expect(json.confidence).to.be.within(0, 1);",
                  "  pm.expect(json).to.have.property('risk_level');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "06_Local_only_NonFunctional",
      "item": [
        {
          "name": "Health response time SLA",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.environment.get('env') === 'local') {",
                  "  pm.test('Response time is below 1000ms on local service', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "  });",
                  "} else {",
                  "  pm.test('Latency SLA skipped on mock environment', function () {",
                  "    pm.expect(pm.environment.get('env')).to.eql('mock');",
                  "  });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
